# API server
PORT=5000
NODE_ENV=development

# Secret required to publish verified items to the Daily Feed API
FEED_ADMIN_KEY=replace-with-a-long-random-secret

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:local_dev_password@localhost:5432/startup_graveyard
# ChromaDB
CHROMA_URL=http://localhost:8000
CHROMA_COLLECTION=startup_graveyard

# LLM provider settings; use a model name supported by your provider
LLM_PROVIDER=openai
LLM_API_KEY=replace-with-your-private-api-key
LLM_MODEL=replace-with-your-model-name
OPENAI_API_KEY=your_secret_api_key
OPENAI_MODEL=your_model_id
